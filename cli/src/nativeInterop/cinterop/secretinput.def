---
#include <string.h>

#if defined(_WIN32)
#include <conio.h>
#endif

void clear_secret_buffer(char* buffer) {
    if (buffer != NULL) {
        memset(buffer, 0, strlen(buffer));
    }
}

int read_console_char_no_echo(void) {
#if defined(_WIN32)
    return _getwch();
#else
    return -1;
#endif
}
